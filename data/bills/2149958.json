{
  "billId": 2149958,
  "billNumber": "S1082",
  "title": "NC Right to Work Amendment",
  "status": "2",
  "chamber": "S",
  "changeHash": "4ea4b6e567e0840a6368a68bbb037ad5",
  "lastAction": "Ref To Com On Rules, Calendar, and Operations of the House",
